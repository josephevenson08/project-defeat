# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
.env
.env.*
!.env.example
test-results/
playwright-report/
coverage/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
# Agent scratch space (worktrees, locks, launch config) stays local, but the project's own
# skills and agent definitions are part of the repo — they describe how to work on THIS project.
.claude/*
!.claude/skills/
!.claude/agents/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Obsidian per-machine UI state. graph.json and app.json are both written by `npm run brain`
# (graph colour groups and the vault's excluded-folder list) and ARE tracked, so a vault opened on
# a fresh machine is usable without reconfiguring it by hand.
.obsidian/appearance.json
.obsidian/core-plugins.json
.obsidian/workspace.json

# Upstream item data fetched by tools/ingest; regenerated on demand, not part of the repo.
tools/ingest/.cache/
