    {
      "className": "Warrior",
      "talent": "Deep Wounds",
      "reason": "A bleed proc on crit — a damage-over-time source, not a stat, and the simulator has no DoT layer for physical specials."
    },
    {
      "className": "Warrior",
      "talent": "Death Wish",
      "reason": "An activated cooldown. Uptime depends on fight length and usage policy, neither of which this model has."
    },
    {
      "className": "Warrior",
      "talent": "Rampage",
      "reason": "Stacking on-hit attack power. Needs a timeline to build stacks."
    },
    {
      "className": "Warrior",
      "talent": "Enrage",
      "reason": "Triggers on being crit by the target — the model has no incoming-damage stream for a DPS."
    },
    {
      "className": "Warrior",
      "talent": "Sweeping Strikes",
      "reason": "Extra targets. Single-target model."
    },
    {
      "className": "Warrior",
      "talent": "Blood Frenzy",
      "reason": "A debuff on the target rather than a change to the player."
    },
    {
      "className": "Warrior",
      "talent": "Mace/Sword/Poleaxe Specialization",
      "reason": "Weapon-type gated, and the mace one is a stun proc. Would need per-weapon-type dispatch that nothing else needs yet."
    },
    {
      "className": "Warrior",
      "talent": "Impale",
      "reason": "Raises the crit damage bonus of abilities only. Real, but it belongs with the special-attack table rather than the white-swing modifiers this pass covers."
    },
    {
      "className": "Warrior",
      "talent": "Toughness / Vitality",
      "reason": "Multiply armour, stamina and strength, which calculateStats owns. Taking them means talents reaching the always-visible stat rail, gear rankings and the upgrade finder — a product decision reserved for the repo owner, not an ingest."
    },
    {
      "className": "Warrior",
      "talent": "Defiance",
      "reason": "Grants expertise, which is a threat and hit-table term on the attacking side. The tank path scores survivability and never rolls the player's own attack table."
    },
    {
      "className": "Warrior",
      "talent": "Shield Mastery",
      "reason": "Raises block VALUE. The incoming-attack table models block as a chance and does not track how much a block absorbs, so there is nothing for this to change."
    },
    {
      "className": "Rogue",
      "talent": "Vitality / Sinister Calling",
      "reason": "Both multiply Agility, which cascades into attack power and crit inside calculateStats. Talents deliberately reach only the simulation, so applying these would mean re-deriving what calculateStats already derives."
    },
    {
      "className": "Rogue",
      "talent": "Murder",
      "reason": "Gated on the target being a humanoid, beast, giant or dragonkin. Nothing here models a mob type."
    },
    {
      "className": "Rogue",
      "talent": "Serrated Blades",
      "reason": "Grants armor penetration, which the engine genuinely does not read — it is the one stat still legitimately on the \"not modelled\" list."
    },
    {
      "className": "Rogue",
      "talent": "Combat Potency",
      "reason": "Energy returned on off-hand hits. The energy budget is a flat 10/sec, with no income model to feed."
    },
    {
      "className": "Rogue",
      "talent": "Seal Fate / Ruthlessness / Relentless Strikes",
      "reason": "Combo-point economy. There is no combo-point resource here at all."
    },
    {
      "className": "Rogue",
      "talent": "Adrenaline Rush / Blade Flurry / Cold Blood",
      "reason": "Activated cooldowns; uptime needs a usage policy this model has none of."
